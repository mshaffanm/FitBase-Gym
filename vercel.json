{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/sweep", "schedule": "0 3 * * *" }]
}